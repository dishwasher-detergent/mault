WEB_URL=http://localhost:5173
PORT=3001

# Get from neon.com
DATABASE_URL=
NEON_AUTH_URL=
VITE_NEON_DATA_API_URL=
VITE_NEON_AUTH_URL=

# Generate yourself (any random string) - signs/verifies short-lived admin
# impersonation tokens (see middleware/auth.ts's signImpersonationToken).
# Distinct from Neon Auth's own JWTs, which we only ever verify.
IMPERSONATION_SECRET=

# Optional - tuning for the admin card-image-vector sync job
VECTORIZE_CONCURRENCY=1
SYNC_INSERT_BATCH_SIZE=50
SCAN_VECTORIZE_CONCURRENCY=2

# Discord bot (packages/bot) - see the Discord Developer Portal for the
# application's bot token/client id, and generate BOT_API_SECRET yourself
# (any random string, shared between the server and the bot process).
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
BOT_API_SECRET=
SERVER_URL=http://localhost:3001
# Optional - registers commands to one guild instantly instead of globally
# (global registration can take up to an hour to propagate). Handy for local dev.
DISCORD_DEV_GUILD_ID=
# The bot's own inbound HTTP server (receives error notifications to post -
# see sendDiscordErrorNotification), and the URL the server uses to reach it.
BOT_PORT=3002
BOT_URL=http://localhost:3002

# Public variables for the React app
VITE_API_URL=http://localhost:3001
VITE_APP_ENV=local
VITE_LATEST_FIRMWARE_VERSION=1.0.1 # Must match the latest release in main.ino