FROM node:20-alpine AS builder
RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

# Copy manifests for layer caching
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/shared/package.json packages/shared/
COPY packages/web/package.json packages/web/
RUN pnpm install --frozen-lockfile

# Copy source
COPY packages/shared/ packages/shared/
COPY packages/web/ packages/web/

ARG VITE_API_URL
ARG VITE_NEON_AUTH_URL
ARG VITE_NEON_DATA_API_URL
ARG VITE_APP_ENV
ARG VITE_LATEST_FIRMWARE_VERSION
ENV VITE_API_URL=$VITE_API_URL \
    VITE_NEON_AUTH_URL=$VITE_NEON_AUTH_URL \
    VITE_NEON_DATA_API_URL=$VITE_NEON_DATA_API_URL \
    VITE_APP_ENV=$VITE_APP_ENV \
    VITE_LATEST_FIRMWARE_VERSION=$VITE_LATEST_FIRMWARE_VERSION

RUN pnpm --filter @magic-vault/web build

FROM nginx:alpine
COPY --from=builder /app/packages/web/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/templates/default.conf.template
ENV API_URL=http://localhost:3001
EXPOSE 80
